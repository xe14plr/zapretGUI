<Page
    x:Class="ZapretGUI.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="О программе">
    <StackPanel Margin="24" MaxWidth="640">
        <TextBlock Text="О программе" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
            ZapretGUI — неофициальная графическая оболочка для
            <Run FontWeight="SemiBold" Text=" zapret-discord-youtube "/>
            (Flowseal), которая в свою очередь основана на
            <Run FontWeight="SemiBold" Text=" zapret "/>
            (bol-van) и драйвере WinDivert.
        </TextBlock>

        <ui:InfoBar
            Title="WinDivert и антивирусы"
            Message="WinDivert может вызывать реакцию антивируса (детект вида WinDivert / Not-a-virus:RiskTool.Multi.WinDivert). Это инструмент перехвата трафика, используемый zapret — сам по себе он не является вирусом. При проблемах добавьте папку программы в исключения антивируса."
            Severity="Warning"
            IsOpen="True"
            IsClosable="False"
            Margin="0,0,0,12"/>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="Ссылки:"/>
        <TextBlock Text="github.com/Flowseal/zapret-discord-youtube" Margin="0,0,0,2"/>
        <TextBlock Text="github.com/bol-van/zapret" Margin="0,0,0,12"/>

        <TextBlock Text="Лицензия: MIT" Opacity="0.7"/>
    </StackPanel>
</Page>
