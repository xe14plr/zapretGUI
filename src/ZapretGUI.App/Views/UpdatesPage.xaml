<Page
    x:Class="ZapretGUI.App.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ZapretGUI.App.ViewModels"
    d:DataContext="{d:DesignInstance vm:UpdatesViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Обновления"
    d:DesignWidth="720" d:DesignHeight="480">

    <StackPanel Margin="24" MaxWidth="680">
        <TextBlock Text="Обновления" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock
            Text="Проверка новой версии набора стратегий/списков из репозитория zapret-discord-youtube."
            Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <ui:CardControl Margin="0,0,0,16">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="TagMultiple24"/>
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Установленная версия стратегий" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LocalVersion}" Opacity="0.7" Margin="0,2,0,0"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="Проверить обновления" Appearance="Primary" Command="{Binding CheckCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24"/>
                </ui:Button.Icon>
            </ui:Button>
        </ui:CardControl>

        <ui:ProgressRing
            IsIndeterminate="True"
            Width="20" Height="20"
            HorizontalAlignment="Left"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
            Margin="0,0,0,12"/>

        <ui:InfoBar
            Title="Ошибка проверки"
            Message="{Binding Error}"
            IsOpen="{Binding Error, Converter={StaticResource NullOrEmptyToBoolConverter}, Mode=OneWay}"
            Severity="Error"
            Margin="0,0,0,12"/>

        <ui:InfoBar
            Title="Доступно обновление"
            Message="{Binding UpdateMessage}"
            IsOpen="{Binding UpdateAvailable}"
            Severity="Warning"
            Margin="0,0,0,12"/>

        <ui:Button
            Content="Открыть страницу релиза"
            Command="{Binding OpenReleasesPageCommand}"
            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
            Margin="0,0,0,12"/>

        <ui:InfoBar
            Title="Установлена последняя версия"
            Message="Обновлений не найдено."
            Severity="Success"
            Margin="0,0,0,12">
            <ui:InfoBar.IsOpen>
                <MultiBinding Converter="{StaticResource UpToDateConverter}">
                    <Binding Path="HasChecked"/>
                    <Binding Path="UpdateAvailable"/>
                    <Binding Path="Error"/>
                </MultiBinding>
            </ui:InfoBar.IsOpen>
        </ui:InfoBar>

    </StackPanel>
</Page>
