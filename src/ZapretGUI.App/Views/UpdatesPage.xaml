<UserControl
    x:Class="ZapretGUI.App.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ZapretGUI.App.ViewModels"
    xmlns:controls="clr-namespace:ZapretGUI.App.Controls"
    d:DataContext="{d:DesignInstance vm:UpdatesViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{DynamicResource Brush.App.Background}"
    d:DesignWidth="720" d:DesignHeight="480">

    <StackPanel Margin="24" MaxWidth="680">
        <TextBlock Text="Обновления" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock
            Text="Проверка новой версии набора стратегий/списков из репозитория zapret-discord-youtube."
            Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource Icon.Tag}" Stroke="{DynamicResource Brush.Text.Secondary}"
                      StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Установленная версия стратегий" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LocalVersion}" Opacity="0.7" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CheckCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Refresh}" Stroke="{DynamicResource Brush.Text.OnAccent}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"/>
                        <TextBlock Text="Проверить обновления" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.OnAccent}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <controls:Spinner HorizontalAlignment="Left" Margin="0,0,0,12"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <controls:InfoBanner
            Title="Ошибка проверки" Severity="Error"
            Message="{Binding Error}"
            IsOpen="{Binding Error, Converter={StaticResource NullOrEmptyToBoolConverter}, Mode=OneWay}"
            Margin="0,0,0,12"/>

        <controls:InfoBanner
            Title="Доступно обновление" Severity="Warning"
            Message="{Binding UpdateMessage}"
            IsOpen="{Binding UpdateAvailable}"
            Margin="0,0,0,12"/>

        <Button
            Content="Открыть страницу релиза"
            Command="{Binding OpenReleasesPageCommand}"
            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
            Margin="0,0,0,12"/>

        <controls:InfoBanner
            Title="Установлена последняя версия" Severity="Success"
            Message="Обновлений не найдено."
            Margin="0,0,0,12">
            <controls:InfoBanner.IsOpen>
                <MultiBinding Converter="{StaticResource UpToDateConverter}">
                    <Binding Path="HasChecked"/>
                    <Binding Path="UpdateAvailable"/>
                    <Binding Path="Error"/>
                </MultiBinding>
            </controls:InfoBanner.IsOpen>
        </controls:InfoBanner>

    </StackPanel>
</UserControl>
