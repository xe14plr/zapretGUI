<Page
    x:Class="ZapretGUI.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ZapretGUI.App.ViewModels"
    d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Обзор"
    d:DesignWidth="820" d:DesignHeight="600">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">

            <TextBlock Text="Обзор" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <ui:InfoBar
                Title="Ошибка"
                Message="{Binding LastError}"
                IsOpen="{Binding LastError, Converter={StaticResource NullOrEmptyToBoolConverter}, Mode=OneWay}"
                Severity="Error"
                Margin="0,0,0,16"/>

            <ui:CardExpander IsExpanded="True" Margin="0,0,0,16">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="ShieldCheckmark24"/>
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel Orientation="Vertical" Margin="8,4">
                        <TextBlock Text="Статус обхода" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="{Binding StatusText}" Opacity="0.7" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:CardExpander.Header>

                <StackPanel Margin="8,8,8,8">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Стратегия:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox
                            Grid.Column="1"
                            ItemsSource="{Binding Strategies}"
                            SelectedItem="{Binding SelectedStrategy}"
                            DisplayMemberPath="DisplayName"
                            MinWidth="260"
                            HorizontalAlignment="Left"/>
                    </Grid>

                    <WrapPanel Orientation="Horizontal">
                        <ui:Button
                            Content="Запустить вручную"
                            Appearance="Primary"
                            Command="{Binding RunStandaloneCommand}"
                            Margin="0,0,8,8">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Play24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Content="Остановить"
                            Command="{Binding StopCommand}"
                            Margin="0,0,8,8">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Stop24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Content="Установить как службу"
                            Command="{Binding InstallServiceCommand}"
                            Margin="0,0,8,8">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Content="Удалить службу"
                            Appearance="Danger"
                            Command="{Binding RemoveServiceCommand}"
                            Margin="0,0,8,8">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Content="Обновить статус"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,8,8">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </WrapPanel>

                    <ui:ProgressRing
                        IsIndeterminate="True"
                        Width="20" Height="20"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,8,0,0"/>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardControl Margin="0,0,0,16">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Settings24"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Служба Windows" FontWeight="SemiBold"/>
                        <TextBlock Opacity="0.7" Margin="0,2,0,0">
                            <Run Text="Установлена: "/>
                            <Run Text="{Binding IsServiceInstalled}"/>
                            <Run Text=" · Стратегия: "/>
                            <Run Text="{Binding InstalledStrategyDisplay}"/>
                        </TextBlock>
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

        </StackPanel>
    </ScrollViewer>
</Page>
