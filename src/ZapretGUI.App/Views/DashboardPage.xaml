<UserControl
    x:Class="ZapretGUI.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ZapretGUI.App.ViewModels"
    xmlns:controls="clr-namespace:ZapretGUI.App.Controls"
    d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    d:DesignWidth="820" d:DesignHeight="600">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Обзор" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding ServiceHealth}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Ellipse Style="{StaticResource HealthDotStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" Opacity="0.8" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <controls:InfoBanner
                Title="Ошибка" Severity="Error"
                Message="{Binding LastError}"
                IsOpen="{Binding LastError, Converter={StaticResource NullOrEmptyToBoolConverter}, Mode=OneWay}"
                Margin="0,0,0,16"/>

            <controls:InfoBanner
                Title="Готово" Severity="Success"
                Message="{Binding LastMessage}"
                IsOpen="{Binding LastMessage, Converter={StaticResource NullOrEmptyToBoolConverter}, Mode=OneWay}"
                Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Path Data="{StaticResource Icon.Shield}" Stroke="{DynamicResource Brush.Accent}"
                              StrokeThickness="1.6" Width="22" Height="22" Stretch="Uniform" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Статус обхода" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="{Binding StatusText}" Opacity="0.7" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Auto / Manual segmented toggle -->
                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="9" Padding="3"
                            HorizontalAlignment="Left" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="Авто" Style="{StaticResource SegmentButtonStyle}"
                                          IsChecked="{Binding IsAutoMode, Mode=OneWay}"
                                          Command="{Binding SetAutoModeCommand}"/>
                            <ToggleButton Content="Вручную" Style="{StaticResource SegmentButtonStyle}"
                                          IsChecked="{Binding IsAutoMode, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"
                                          Command="{Binding SetManualModeCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Manual-only: pick a specific strategy via the bottom drawer -->
                    <Button HorizontalAlignment="Left" Margin="0,0,0,12"
                            Command="{Binding OpenStrategyDrawerCommand}"
                            Visibility="{Binding IsAutoMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Opacity="0.7" Text="Стратегия: "/>
                            <TextBlock Text="{Binding SelectedStrategy.DisplayName}" FontWeight="SemiBold" Margin="2,0,6,0"/>
                            <Path Data="{StaticResource Icon.ChevronDown}" Fill="{DynamicResource Brush.Text.Secondary}"
                                  Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Play}" Fill="{DynamicResource Brush.Text.OnAccent}" Width="14" Height="14" Stretch="Uniform"/>
                                <TextBlock Text="{Binding RunButtonLabel}" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.OnAccent}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Square}" Fill="{DynamicResource Brush.Text.Primary}" Width="12" Height="12" Stretch="Uniform"/>
                                <TextBlock Text="Остановить" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding InstallServiceCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Download}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"/>
                                <TextBlock Text="Установить как службу" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding RemoveServiceCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Delete}" Stroke="{DynamicResource Brush.Text.OnAccent}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"/>
                                <TextBlock Text="Удалить службу" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.OnAccent}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Refresh}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"/>
                                <TextBlock Text="Обновить статус" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <controls:Spinner HorizontalAlignment="Left" Margin="0,10,0,0"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Settings}" Stroke="{DynamicResource Brush.Text.Secondary}"
                          StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Служба Windows" FontWeight="SemiBold"/>
                        <TextBlock Opacity="0.7" Margin="0,2,0,0">
                            <Run Text="Установлена: "/>
                            <Run Text="{Binding IsServiceInstalled}"/>
                            <Run Text=" · Стратегия: "/>
                            <Run Text="{Binding InstalledStrategyDisplay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
