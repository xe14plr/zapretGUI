<UserControl
    x:Class="ZapretGUI.App.Views.StrategiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ZapretGUI.App.ViewModels"
    xmlns:controls="clr-namespace:ZapretGUI.App.Controls"
    d:DataContext="{d:DesignInstance vm:StrategiesViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{DynamicResource Brush.App.Background}"
    d:DesignWidth="900" d:DesignHeight="640">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Для опытных: все стратегии" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock
                Text="Каждая стратегия — это готовый набор параметров winws.exe. Работоспособность зависит от провайдера — пробуйте разные, пока не найдёте рабочую."
                Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox
                Grid.Column="0"
                ItemsSource="{Binding Strategies}"
                SelectedItem="{Binding SelectedStrategy}"
                DisplayMemberPath="DisplayName"/>

            <StackPanel Grid.Column="2">
                <controls:InfoBanner
                    Title="Ошибка" Severity="Error"
                    Message="{Binding LastError}"
                    IsOpen="{Binding LastError, Converter={StaticResource NullOrEmptyToBoolConverter}, Mode=OneWay}"
                    Margin="0,0,0,12"/>

                <controls:InfoBanner
                    Title="Готово" Severity="Success"
                    Message="{Binding LastMessage}"
                    IsOpen="{Binding LastMessage, Converter={StaticResource NullOrEmptyToBoolConverter}, Mode=OneWay}"
                    Margin="0,0,0,12"/>

                <TextBlock
                    Text="{Binding SelectedStrategy.DisplayName}"
                    FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunCommand}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Play}" Fill="{DynamicResource Brush.Text.OnAccent}" Width="14" Height="14" Stretch="Uniform"/>
                            <TextBlock Text="Запустить вручную" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.OnAccent}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding InstallServiceCommand}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Download}" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"/>
                            <TextBlock Text="Установить как службу" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Path Data="{StaticResource Icon.Code}" Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Итоговая команда winws.exe" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBox
                            Text="{Binding GeneratedCommandLine, Mode=OneWay}"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MaxHeight="260"
                            VerticalScrollBarVisibility="Auto"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
