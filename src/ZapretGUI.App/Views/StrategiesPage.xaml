<Page
    x:Class="ZapretGUI.App.Views.StrategiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ZapretGUI.App.ViewModels"
    d:DataContext="{d:DesignInstance vm:StrategiesViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Стратегии"
    d:DesignWidth="900" d:DesignHeight="640">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Стратегии" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock
                Text="Каждая стратегия — это готовый набор параметров winws.exe. Работоспособность зависит от провайдера — пробуйте разные, пока не найдёте рабочую."
                Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:ListView
                Grid.Column="0"
                ItemsSource="{Binding Strategies}"
                SelectedItem="{Binding SelectedStrategy}"
                DisplayMemberPath="DisplayName"/>

            <StackPanel Grid.Column="2">
                <ui:InfoBar
                    Title="Ошибка"
                    Message="{Binding LastError}"
                    IsOpen="{Binding LastError, Converter={StaticResource NullOrEmptyToBoolConverter}, Mode=OneWay}"
                    Severity="Error"
                    Margin="0,0,0,12"/>

                <ui:InfoBar
                    Title="Готово"
                    Message="{Binding LastMessage}"
                    IsOpen="{Binding LastMessage, Converter={StaticResource NullOrEmptyToBoolConverter}, Mode=OneWay}"
                    Severity="Success"
                    Margin="0,0,0,12"/>

                <TextBlock
                    Text="{Binding SelectedStrategy.DisplayName}"
                    FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <ui:Button
                        Content="Запустить вручную"
                        Appearance="Primary"
                        Command="{Binding RunCommand}"
                        Margin="0,0,8,8">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Play24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Content="Установить как службу"
                        Command="{Binding InstallServiceCommand}"
                        Margin="0,0,8,8">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </WrapPanel>

                <ui:CardExpander Header="Итоговая команда winws.exe" Margin="0,0,0,12">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="Code24"/>
                    </ui:CardExpander.Icon>
                    <ui:TextBox
                        Text="{Binding GeneratedCommandLine, Mode=OneWay}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MaxHeight="260"
                        VerticalScrollBarVisibility="Auto"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"/>
                </ui:CardExpander>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
