<UserControl
    x:Class="ZapretGUI.App.Views.Overlays.StrategyDrawerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ZapretGUI.App.ViewModels"
    d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Margin="24">
        <Border Width="36" Height="4" Background="{DynamicResource Brush.Border.Strong}"
                CornerRadius="2" HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <TextBlock Text="Выберите стратегию" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock
            Text="Работоспособность зависит от провайдера — если одна не сработала, попробуйте другую."
            Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ListBox
            x:Name="StrategyList"
            ItemsSource="{Binding Strategies}"
            SelectedItem="{Binding SelectedStrategy}"
            DisplayMemberPath="DisplayName"
            MaxHeight="360"
            SelectionChanged="StrategyList_SelectionChanged"/>
    </StackPanel>
</UserControl>
