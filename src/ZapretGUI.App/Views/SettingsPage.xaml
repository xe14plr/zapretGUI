<Page
    x:Class="ZapretGUI.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ZapretGUI.App.ViewModels"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Настройки"
    d:DesignWidth="780" d:DesignHeight="640">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="720">

            <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <ui:InfoBar
                Title="Ошибка"
                Message="{Binding LastError}"
                IsOpen="{Binding LastError, Converter={StaticResource NullOrEmptyToBoolConverter}, Mode=OneWay}"
                Severity="Error"
                Margin="0,0,0,12"/>

            <ui:InfoBar
                Title="Готово"
                Message="{Binding LastMessage}"
                IsOpen="{Binding LastMessage, Converter={StaticResource NullOrEmptyToBoolConverter}, Mode=OneWay}"
                Severity="Success"
                Margin="0,0,0,12"/>

            <ui:CardExpander IsExpanded="True" Margin="0,0,0,16">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Games24"/>
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel Margin="8,4">
                        <TextBlock Text="Game Filter" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Opacity="0.7" Margin="0,2,0,0">
                            Расширяет диапазон портов (1024-65535) для UDP/TCP трафика игр и других сервисов.
                        </TextBlock>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="8">
                    <ComboBox
                        ItemsSource="{Binding GameFilterOptions}"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding GameFilter}"
                        MinWidth="260"
                        HorizontalAlignment="Left"/>
                    <TextBlock
                        Text="После переключения требуется перезапуск стратегии."
                        Opacity="0.6" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander IsExpanded="True" Margin="0,0,0,16">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="NetworkCheck24"/>
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel Margin="8,4">
                        <TextBlock Text="IPSet Filter" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="{Binding IpsetFilterDescription}" Opacity="0.7" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="8">
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button
                            Content="Переключить режим"
                            Command="{Binding CycleIpsetFilterCommand}"
                            Margin="0,0,8,8">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSwap24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Content="Обновить список IPSet"
                            Command="{Binding UpdateIpsetListCommand}"
                            Margin="0,0,8,8">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </WrapPanel>
                    <TextBlock
                        Text="Полезно при тестировании, если ресурс не работает без zapret. loaded → none → any → loaded по кругу."
                        Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardControl Margin="0,0,0,16">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24"/>
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Автоматическая проверка обновлений" FontWeight="SemiBold"/>
                        <TextBlock Opacity="0.7" Margin="0,2,0,0" Text="Проверять наличие новой версии стратегий при запуске."/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding AutoUpdateEnabled}"/>
            </ui:CardControl>

        </StackPanel>
    </ScrollViewer>
</Page>
