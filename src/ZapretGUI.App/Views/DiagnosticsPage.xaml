<UserControl
    x:Class="ZapretGUI.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ZapretGUI.App.ViewModels"
    xmlns:controls="clr-namespace:ZapretGUI.App.Controls"
    d:DataContext="{d:DesignInstance vm:DiagnosticsViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{DynamicResource Brush.App.Background}"
    d:DesignWidth="820" d:DesignHeight="700">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="780">

            <TextBlock Text="Диагностика" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock
                Text="Проверка распространённых причин, по которым zapret может не работать."
                Opacity="0.7" Margin="0,0,0,16"/>

            <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RunDiagnosticsCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Play}" Fill="{DynamicResource Brush.Text.OnAccent}" Width="14" Height="14" Stretch="Uniform"/>
                        <TextBlock Text="Запустить диагностику" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.OnAccent}"/>
                    </StackPanel>
                </Button>
                <Button Content="Включить TCP timestamps" Command="{Binding FixTcpTimestampsCommand}" Margin="0,0,8,8"/>
                <Button Content="Удалить зависший WinDivert" Command="{Binding RemoveStrayWinDivertCommand}" Margin="0,0,8,8"/>
                <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding RemoveConflictingBypassesCommand}" Margin="0,0,8,8">
                    <TextBlock Text="Удалить конфликтующие обходы" Foreground="{DynamicResource Brush.Text.OnAccent}"/>
                </Button>
                <Button Content="Очистить кэш Discord" Command="{Binding ClearDiscordCacheCommand}" Margin="0,0,8,8"/>
            </WrapPanel>

            <controls:Spinner HorizontalAlignment="Left" Margin="0,0,0,12"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <controls:InfoBanner
                Title="Результат" Severity="Info"
                Message="{Binding LastMessage}"
                IsOpen="{Binding LastMessage, Converter={StaticResource NullOrEmptyToBoolConverter}, Mode=OneWay}"
                Margin="0,0,0,16"/>

            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,12,0"
                                      Data="{Binding Severity, Converter={StaticResource SeverityToIconConverter}}"
                                      Stroke="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"
                                      StrokeThickness="1.6"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Category}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Message}" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
