<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light counterpart of Colors.xaml - same resource keys, swapped at runtime by ThemeService. -->

    <Color x:Key="Color.App.Background">#F5F5F7</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Elevated">#F0F0F3</Color>
    <Color x:Key="Color.Surface.Hover">#E7E7EC</Color>
    <Color x:Key="Color.Border">#DDDDE3</Color>
    <Color x:Key="Color.Border.Strong">#C7C7D1</Color>

    <Color x:Key="Color.Accent">#8B5CF6</Color>
    <Color x:Key="Color.Accent.Hover">#7A46E8</Color>
    <Color x:Key="Color.Accent.Pressed">#6935D6</Color>

    <Color x:Key="Color.Success">#16A34A</Color>
    <Color x:Key="Color.Warning">#D97706</Color>
    <Color x:Key="Color.Error">#DC2626</Color>
    <Color x:Key="Color.Info">#2563EB</Color>

    <Color x:Key="Color.Text.Primary">#18181B</Color>
    <Color x:Key="Color.Text.Secondary">#585B66</Color>
    <Color x:Key="Color.Text.Disabled">#A2A5AF</Color>
    <Color x:Key="Color.Text.OnAccent">#FFFFFF</Color>

    <SolidColorBrush x:Key="Brush.App.Background" Color="{StaticResource Color.App.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{StaticResource Color.Surface.Elevated}"/>
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}"/>
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}"/>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}"/>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}"/>

    <SolidColorBrush x:Key="Brush.Success.Bg" Color="#E7F8ED"/>
    <SolidColorBrush x:Key="Brush.Warning.Bg" Color="#FDF1DE"/>
    <SolidColorBrush x:Key="Brush.Error.Bg" Color="#FBE7E7"/>
    <SolidColorBrush x:Key="Brush.Info.Bg" Color="#E5EEFE"/>

</ResourceDictionary>
