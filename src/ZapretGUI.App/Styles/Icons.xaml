    <PathGeometry x:Key="Icon.Shield" Figures="M12,3 L20,6 V11 C20,16 16.5,20 12,21 C7.5,20 4,16 4,11 V6 Z"/>
    <PathGeometry x:Key="Icon.Code" Figures="M8,7 L3,12 L8,17 M16,7 L21,12 L16,17"/>
    <PathGeometry x:Key="Icon.Swap" Figures="M4,7 H16 L13,4 M4,7 L13,10 M20,17 H8 L11,20 M20,17 L11,14"/>
