    <RectangleGeometry x:Key="Icon.DrawerHandle" Rect="9,10.5,6,3" RadiusX="1.5" RadiusY="1.5"/>
    <PathGeometry x:Key="Icon.Warning" Figures="M12,3 L22,20 H2 Z M12,9.5 V14 M12,16.3 V16.8"/>
