<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Small hand-drawn line-icon set (24x24 viewbox) replacing WPF-UI's SymbolIcon.
        Consumers set Stretch=Uniform + Width/Height and choose Fill or Stroke locally
        depending on whether the icon reads better filled or outlined.
    -->

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
    </Style>

    <PathGeometry x:Key="Icon.Play" Figures="M6,4 L20,12 L6,20 Z"/>
    <RectangleGeometry x:Key="Icon.Square" Rect="6,6,12,12" RadiusX="1.5" RadiusY="1.5"/>
    <PathGeometry x:Key="Icon.Download" Figures="M12,3 V15 M6,10 L12,16 L18,10 M4,20 H20"/>
    <PathGeometry x:Key="Icon.Delete" Figures="M5,7 H19 M9,7 V4 H15 V7 M7,7 L8,20 H16 L17,7 M10,11 V17 M14,11 V17"/>
    <PathGeometry x:Key="Icon.Refresh" Figures="M4,12 A8,8 0 1 0 7,5.5 M4,12 L4,6 M4,12 L10,12"/>
    <GeometryGroup x:Key="Icon.Settings">
        <PathGeometry Figures="M4,7 H20 M4,12 H20 M4,17 H20"/>
        <EllipseGeometry Center="8,7" RadiusX="2" RadiusY="2"/>
        <EllipseGeometry Center="16,12" RadiusX="2" RadiusY="2"/>
        <EllipseGeometry Center="10,17" RadiusX="2" RadiusY="2"/>
    </GeometryGroup>
    <PathGeometry x:Key="Icon.Home" Figures="M4,11 L12,4 L20,11 M6,10 V20 H18 V10"/>
    <PathGeometry x:Key="Icon.Document" Figures="M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19 M9,12 H16 M9,16 H16"/>
    <PathGeometry x:Key="Icon.Pulse" Figures="M3,12 H8 L10,6 L14,18 L16,12 H21"/>
    <GeometryGroup x:Key="Icon.Info">
        <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9"/>
