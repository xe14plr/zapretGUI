<Window
    x:Class="ZapretGUI.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:views="clr-namespace:ZapretGUI.App.Views"
    xmlns:local="clr-namespace:ZapretGUI.App"
    mc:Ignorable="d"
    Title="ZapretGUI"
    Icon="pack://application:,,,/Assets/app.ico"
    Width="1120" Height="720"
    MinWidth="860" MinHeight="560"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResize"
    Background="{DynamicResource Brush.App.Background}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar, also home to the section-launcher icon dock -->
            <Border Grid.Row="0" Height="36" Background="{DynamicResource Brush.Surface}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="ZapretGUI" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Section launchers: open each area as an in-app modal over the Обзор background -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnSettings" Style="{StaticResource ChromeButtonStyle}" Click="OpenSettings_Click" ToolTip="Настройки">
                            <Path Data="{StaticResource Icon.Settings}" Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnLists" Style="{StaticResource ChromeButtonStyle}" Click="OpenLists_Click" ToolTip="Списки">
                            <Path Data="{StaticResource Icon.Document}" Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnDiagnostics" Style="{StaticResource ChromeButtonStyle}" Click="OpenDiagnostics_Click" ToolTip="Диагностика">
                            <Path Data="{StaticResource Icon.Pulse}" Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnUpdates" Style="{StaticResource ChromeButtonStyle}" Click="OpenUpdates_Click" ToolTip="Обновления">
                            <Path Data="{StaticResource Icon.Refresh}" Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnAbout" Style="{StaticResource ChromeButtonStyle}" Click="OpenAbout_Click" ToolTip="О программе">
                            <Path Data="{StaticResource Icon.Info}" Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource ChromeButtonStyle}" Click="Minimize_Click">
                            <Path Data="{StaticResource Icon.Minimize}" Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource ChromeButtonStyle}" Click="Maximize_Click">
                            <Path Data="{StaticResource Icon.Square}" Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource CloseChromeButtonStyle}" Click="Close_Click">
                            <Path Data="{StaticResource Icon.Close}" Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body: Обзор is the permanent background; everything else opens in the overlay layer on top of it -->
            <Grid Grid.Row="1">
                <Canvas x:Name="BackgroundCanvas" ClipToBounds="True"/>
                <views:DashboardPage/>

                <Grid x:Name="OverlayLayer" Visibility="Collapsed">
                    <Border x:Name="Scrim" Background="#B0000000"/>
                    <Border x:Name="ModalPanel"
                            Style="{StaticResource CardStyle}"
                            Background="{DynamicResource Brush.Surface.Elevated}"
                            BorderBrush="{DynamicResource Brush.Border.Strong}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="640" MaxHeight="620" Margin="24"
                            Padding="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" HorizontalAlignment="Right" Margin="4"
                                    Style="{StaticResource ChromeButtonStyle}" Click="CloseModal_Click">
                                <Path Data="{StaticResource Icon.Close}" Stroke="{DynamicResource Brush.Text.Secondary}"
                                      StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>

                            <ContentControl x:Name="ModalContent" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
