<Application x:Class="ZapretGUI.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ZapretGUI.App.Converters"
             xmlns:local="clr-namespace:ZapretGUI.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Icons.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:NullOrEmptyToBoolConverter x:Key="NullOrEmptyToBoolConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:SeverityToIconConverter x:Key="SeverityToIconConverter"/>
            <conv:SeverityToBrushConverter x:Key="SeverityToBrushConverter"/>
            <conv:UpToDateMultiConverter x:Key="UpToDateConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
